---
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardFooter, CardHeader } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";

interface OptionRow {
  id: string;
  name: string;
}

interface CriterionRow {
  id: string;
  name: string;
  weight: number;
}

interface ScoreRow {
  option_id: string;
  criterion_id: string;
  value: number;
}

interface RankingRow {
  optionId: string;
  name: string;
  total: number;
  missing: number;
  rank: number;
}

interface Props {
  email: string | null;
  error: string | null;
  loadErrorMessage: string | null;
  showForm: boolean;
  decisionTitle: string | null;
  options: OptionRow[];
  criteria: CriterionRow[];
  scores: ScoreRow[];
  ranking: RankingRow[] | null;
}

const { email, error, loadErrorMessage, showForm, decisionTitle, options, criteria, scores, ranking } = Astro.props;

const scoreValues = new Map(scores.map((score) => [`${score.option_id}:${score.criterion_id}`, score.value]));
const rankCounts = new Map<number, number>();
for (const row of ranking ?? []) {
  rankCounts.set(row.rank, (rankCounts.get(row.rank) ?? 0) + 1);
}
const canScore = options.length > 0 && criteria.length > 0;
---

<div class="flex min-h-screen justify-center bg-background px-4 py-8 text-foreground">
  <Card className="w-full max-w-2xl">
    <CardHeader>
      <h1 class="text-2xl font-semibold text-foreground">Dashboard</h1>
      <p class="text-muted-foreground">
        Welcome, <span class="font-semibold text-foreground">{email}</span>
      </p>
    </CardHeader>
    <CardContent className="space-y-6">
      {error && (
        <p
          class="rounded-md border border-destructive bg-destructive/10 px-3 py-2 text-sm text-destructive"
          role="alert"
        >
          {error}
        </p>
      )}
      {loadErrorMessage ? (
        <p class="text-sm text-destructive" role="alert">
          {loadErrorMessage}
        </p>
      ) : showForm ? (
        <form method="POST" action="/api/decisions" class="space-y-3">
          <p class="text-sm text-muted-foreground">Name the decision you want to make.</p>
          <Label htmlFor="decision-title">Title</Label>
          <Input id="decision-title" type="text" name="title" maxLength={200} />
          <Button type="submit">Create</Button>
        </form>
      ) : (
        decisionTitle !== null && (
          <div class="space-y-8">
            <p class="text-xl font-semibold text-foreground">{decisionTitle}</p>
            <section class="space-y-3">
              <h2 class="text-lg font-semibold text-foreground">Options</h2>
              {options.length === 0 && <p class="text-sm text-muted-foreground">No options yet.</p>}
              {options.map((option) => (
                <div class="space-y-2 rounded-lg border border-border p-3">
                  <p class="text-sm font-medium text-foreground">{option.name}</p>
                  <form method="POST" action="/api/options" class="space-y-2">
                    <input type="hidden" name="intent" value="update" />
                    <input type="hidden" name="id" value={option.id} />
                    <Label className="flex-col items-stretch gap-1 text-muted-foreground">
                      Name
                      <Input type="text" name="name" value={option.name} maxLength={200} />
                    </Label>
                    <Button type="submit" variant="outline" size="sm">
                      Save
                    </Button>
                  </form>
                  <form method="POST" action="/api/options">
                    <input type="hidden" name="intent" value="delete" />
                    <input type="hidden" name="id" value={option.id} />
                    <Button type="submit" variant="destructive" size="sm">
                      Delete
                    </Button>
                  </form>
                </div>
              ))}
              {options.length < 20 && (
                <form method="POST" action="/api/options" class="space-y-2">
                  <input type="hidden" name="intent" value="create" />
                  <Label className="flex-col items-stretch gap-1 text-muted-foreground">
                    Option
                    <Input type="text" name="name" maxLength={200} />
                  </Label>
                  <Button type="submit">Add option</Button>
                </form>
              )}
            </section>
            <section class="space-y-3">
              <h2 class="text-lg font-semibold text-foreground">Criteria</h2>
              {criteria.length === 0 && <p class="text-sm text-muted-foreground">No criteria yet.</p>}
              {criteria.map((criterion) => (
                <div class="space-y-2 rounded-lg border border-border p-3">
                  <p class="text-sm font-medium text-foreground">
                    {criterion.name} ({criterion.weight})
                  </p>
                  <form method="POST" action="/api/criteria" class="space-y-2">
                    <input type="hidden" name="intent" value="update" />
                    <input type="hidden" name="id" value={criterion.id} />
                    <Label className="flex-col items-stretch gap-1 text-muted-foreground">
                      Name
                      <Input type="text" name="name" value={criterion.name} maxLength={200} />
                    </Label>
                    <Label className="flex-col items-stretch gap-1 text-muted-foreground">
                      Weight
                      <Input type="number" name="weight" min={1} max={5} value={criterion.weight} />
                    </Label>
                    <Button type="submit" variant="outline" size="sm">
                      Save
                    </Button>
                  </form>
                  <form method="POST" action="/api/criteria">
                    <input type="hidden" name="intent" value="delete" />
                    <input type="hidden" name="id" value={criterion.id} />
                    <Button type="submit" variant="destructive" size="sm">
                      Delete
                    </Button>
                  </form>
                </div>
              ))}
              {criteria.length < 20 && (
                <form method="POST" action="/api/criteria" class="space-y-2">
                  <input type="hidden" name="intent" value="create" />
                  <Label className="flex-col items-stretch gap-1 text-muted-foreground">
                    Criterion
                    <Input type="text" name="name" maxLength={200} />
                  </Label>
                  <Label className="flex-col items-stretch gap-1 text-muted-foreground">
                    Weight
                    <Input type="number" name="weight" min={1} max={5} />
                  </Label>
                  <Button type="submit">Add criterion</Button>
                </form>
              )}
            </section>
            {canScore && (
              <section class="space-y-3">
                <h2 class="text-lg font-semibold text-foreground">Scores</h2>
                <p class="text-sm text-muted-foreground">
                  Score each option from 1 to 5. Leave a field blank for no score.
                </p>
                {options.map((option) => (
                  <form method="POST" action="/api/scores" class="space-y-2 rounded-lg border border-border p-3">
                    <input type="hidden" name="option_id" value={option.id} />
                    <p class="text-sm font-medium text-foreground">{option.name}</p>
                    {criteria.map((criterion) => (
                      <Label className="flex-col items-stretch gap-1 text-muted-foreground">
                        {criterion.name} ({criterion.weight})
                        <Input
                          type="number"
                          name={`score_${criterion.id}`}
                          min={1}
                          max={5}
                          value={scoreValues.get(`${option.id}:${criterion.id}`) ?? ""}
                        />
                      </Label>
                    ))}
                    <Button type="submit" variant="outline" size="sm">
                      Save scores
                    </Button>
                  </form>
                ))}
              </section>
            )}
            {canScore && (
              <section class="space-y-3">
                <h2 class="text-lg font-semibold text-foreground">Ranking</h2>
                {ranking === null ? (
                  <p class="text-sm text-muted-foreground">No scores yet.</p>
                ) : (
                  <ol class="space-y-2">
                    {ranking.map((row) => (
                      <li class="flex flex-wrap items-center gap-2 rounded-lg border border-border p-3 text-sm">
                        <span class="font-semibold text-foreground">{row.rank}.</span>
                        <span class="font-medium text-foreground">{row.name}</span>
                        <span class="text-muted-foreground">Total {row.total}</span>
                        {row.missing > 0 && (
                          <span class="rounded-md border border-border px-2 py-0.5 text-muted-foreground">
                            incomplete ({row.missing} missing)
                          </span>
                        )}
                        {(rankCounts.get(row.rank) ?? 0) > 1 && (
                          <span class="rounded-md border border-border px-2 py-0.5 text-muted-foreground">tie</span>
                        )}
                      </li>
                    ))}
                  </ol>
                )}
              </section>
            )}
          </div>
        )
      )}
    </CardContent>
    <CardFooter>
      <form method="POST" action="/api/auth/signout">
        <Button type="submit" variant="outline">
          Sign out
        </Button>
      </form>
    </CardFooter>
  </Card>
</div>
