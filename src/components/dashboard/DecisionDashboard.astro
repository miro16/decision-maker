---
import DecisionTable from "@/components/dashboard/DecisionTable.astro";
import { TieBreakerWheel } from "@/components/tie-breaker/TieBreakerWheel";
import { Alert } from "@/components/ui/alert";
import { Button, buttonVariants } from "@/components/ui/button";
import { Card, CardContent, CardFooter, CardHeader } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { cn } from "@/lib/utils";
interface DecisionRow {
  id: string;
  title: string;
}

interface OptionRow {
  id: string;
  name: string;
}

interface CriterionRow {
  id: string;
  name: string;
  weight: number;
}

interface ScoreRow {
  option_id: string;
  criterion_id: string;
  value: number;
}

interface RankingRow {
  optionId: string;
  name: string;
  total: number;
  missing: number;
  rank: number;
}

interface Props {
  email: string | null;
  error: string | null;
  loadErrorMessage: string | null;
  showForm: boolean;
  decisions: DecisionRow[];
  decisionId: string | null;
  decisionTitle: string | null;
  confirmDelete: boolean;
  options: OptionRow[];
  criteria: CriterionRow[];
  scores: ScoreRow[];
  ranking: RankingRow[] | null;
  tieCandidates?: OptionRow[];
  tieTotal?: number | null;
  /** State sink only: shows a finished draw for this option without spinning. */
  tieWinnerId?: string;
}

const {
  email,
  error,
  loadErrorMessage,
  showForm,
  decisions,
  decisionId,
  decisionTitle,
  confirmDelete,
  options,
  criteria,
  scores,
  ranking,
  tieCandidates = [],
  tieTotal = null,
  tieWinnerId,
} = Astro.props;

const canScore = options.length > 0 && criteria.length > 0;
const decisionHref = decisionId ? `/dashboard?decision=${encodeURIComponent(decisionId)}` : "/dashboard";
const deleteHref = `${decisionHref}&confirm=delete`;
const count = (n: number, singular: string, plural: string) => `${n} ${n === 1 ? singular : plural}`;
---

<div class="flex min-h-screen justify-center bg-background px-4 py-8 text-foreground">
  <Card className="w-full max-w-5xl shadow-glow!">
    <CardHeader>
      <h1 class="text-2xl font-semibold text-foreground">Dashboard</h1>
      <p class="text-muted-foreground">
        Welcome, <span class="font-semibold text-foreground">{email}</span>
      </p>
    </CardHeader>
    <CardContent className="space-y-6">
      {error && (
        <Alert variant="destructive" role="alert" className="grid-cols-1 border-destructive">
          {error}
        </Alert>
      )}
      {loadErrorMessage ? (
        <Alert variant="destructive" role="alert" className="grid-cols-1 border-destructive">
          {loadErrorMessage}
        </Alert>
      ) : (
        <div class="space-y-8">
          {decisions.length > 0 && (
            <section class="space-y-3">
              <h2 class="text-lg font-semibold text-foreground">Your decisions</h2>
              <ul class="space-y-2">
                {decisions.map((decision) => (
                  <li>
                    <a
                      href={`/dashboard?decision=${encodeURIComponent(decision.id)}`}
                      aria-current={decision.id === decisionId ? "page" : undefined}
                      class:list={cn(
                        buttonVariants({ variant: "outline" }),
                        "h-auto w-full justify-start whitespace-normal py-2 text-left break-words",
                        decision.id === decisionId &&
                          "bg-accent font-semibold text-accent-foreground shadow-glow! dark:bg-accent dark:hover:bg-accent",
                      )}
                    >
                      {decision.title}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}
          {showForm && (
            <form method="POST" action="/api/decisions" class="space-y-3">
              <input type="hidden" name="intent" value="create" />
              <p class="text-sm text-muted-foreground">Name the decision you want to make.</p>
              <Label htmlFor="decision-title">What are you deciding?</Label>
              <Input id="decision-title" type="text" name="title" maxLength={200} />
              <Button type="submit">Add decision</Button>
            </form>
          )}
          {decisionTitle !== null && (
            <div class="space-y-8">
              <section class="space-y-3">
                <div class="space-y-1">
                  <p class="text-sm text-muted-foreground">Decision</p>
                  <h2 class="text-xl font-semibold text-foreground">{decisionTitle}</h2>
                </div>
                <form method="POST" action="/api/decisions" class="space-y-2">
                  <input type="hidden" name="intent" value="rename" />
                  <input type="hidden" name="id" value={decisionId} />
                  <Label htmlFor="decision-rename-title">Title</Label>
                  <Input id="decision-rename-title" type="text" name="title" value={decisionTitle} maxLength={200} />
                  <Button type="submit" variant="outline">
                    Rename
                  </Button>
                </form>
                {!confirmDelete && (
                  <a
                    href={deleteHref}
                    class:list={cn(
                      buttonVariants({ variant: "outline", size: "sm" }),
                      "border-destructive text-destructive dark:border-destructive",
                    )}
                  >
                    Delete decision
                  </a>
                )}
                {confirmDelete && (
                  <Card className="gap-0 rounded-lg border-destructive py-3 shadow-none">
                    <CardContent className="px-3">
                      <div class="space-y-3">
                        <p class="text-sm text-foreground">
                          Deleting "{decisionTitle}" also deletes its {count(options.length, "option", "options")},{" "}
                          {count(criteria.length, "criterion", "criteria")} and all scores. This cannot be undone.
                        </p>
                        <div class="flex flex-wrap items-center gap-3">
                          <form method="POST" action="/api/decisions">
                            <input type="hidden" name="intent" value="delete" />
                            <input type="hidden" name="id" value={decisionId} />
                            <Button type="submit" variant="destructive">
                              Delete permanently
                            </Button>
                          </form>
                          <a href={decisionHref} class:list={buttonVariants({ variant: "outline" })}>
                            Cancel
                          </a>
                        </div>
                      </div>
                    </CardContent>
                  </Card>
                )}
              </section>
              <section class="space-y-3">
                <h2 class="text-lg font-semibold text-foreground">Decision table</h2>
                {canScore ? (
                  <DecisionTable
                    decisionId={decisionId}
                    options={options}
                    criteria={criteria}
                    scores={scores}
                    ranking={ranking}
                  />
                ) : (
                  <p class="text-sm text-muted-foreground">
                    Add at least one option and one criterion to fill in the table.
                  </p>
                )}
              </section>
              {tieCandidates.length > 1 && (
                <section class="space-y-3">
                  <h2 class="text-lg font-semibold text-foreground">Tie-breaker</h2>
                  <p class="text-sm text-muted-foreground">
                    {count(tieCandidates.length, "option", "options")} share first place with Total {tieTotal}. Spinning
                    does not change the ranking.
                  </p>
                  <TieBreakerWheel candidates={tieCandidates} previewWinnerId={tieWinnerId} client:load />
                </section>
              )}
              <section class="space-y-8">
                <h2 class="text-lg font-semibold text-foreground">Manage options and criteria</h2>
                <section class="space-y-3">
                  <h3 class="text-base font-semibold text-foreground">Options</h3>
                  {options.length === 0 && <p class="text-sm text-muted-foreground">No options yet.</p>}
                  {options.map((option) => (
                    <Card className="gap-0 rounded-lg py-3 shadow-none">
                      <CardContent className="px-3">
                        <div class="space-y-2">
                          <p class="text-sm font-medium text-foreground">{option.name}</p>
                          <form method="POST" action="/api/options" class="space-y-2">
                            <input type="hidden" name="decision_id" value={decisionId} />
                            <input type="hidden" name="intent" value="update" />
                            <input type="hidden" name="id" value={option.id} />
                            <Label className="flex-col items-stretch gap-1 text-muted-foreground">
                              Name
                              <Input
                                type="text"
                                name="name"
                                value={option.name}
                                maxLength={200}
                                className="text-foreground"
                              />
                            </Label>
                            <Button type="submit" variant="outline" size="sm">
                              Save
                            </Button>
                          </form>
                          <form method="POST" action="/api/options">
                            <input type="hidden" name="decision_id" value={decisionId} />
                            <input type="hidden" name="intent" value="delete" />
                            <input type="hidden" name="id" value={option.id} />
                            <Button type="submit" variant="destructive" size="sm">
                              Delete
                            </Button>
                          </form>
                        </div>
                      </CardContent>
                    </Card>
                  ))}
                  {options.length < 20 && (
                    <form method="POST" action="/api/options" class="space-y-2">
                      <input type="hidden" name="decision_id" value={decisionId} />
                      <input type="hidden" name="intent" value="create" />
                      <Label className="flex-col items-stretch gap-1 text-muted-foreground">
                        Option
                        <Input type="text" name="name" maxLength={200} className="text-foreground" />
                      </Label>
                      <Button type="submit">Add option</Button>
                    </form>
                  )}
                </section>
                <section class="space-y-3">
                  <h3 class="text-base font-semibold text-foreground">Criteria</h3>
                  {criteria.length === 0 && <p class="text-sm text-muted-foreground">No criteria yet.</p>}
                  {criteria.map((criterion) => (
                    <Card className="gap-0 rounded-lg py-3 shadow-none">
                      <CardContent className="px-3">
                        <div class="space-y-2">
                          <p class="text-sm font-medium text-foreground">
                            {criterion.name} ({criterion.weight})
                          </p>
                          <form method="POST" action="/api/criteria" class="space-y-2">
                            <input type="hidden" name="decision_id" value={decisionId} />
                            <input type="hidden" name="intent" value="update" />
                            <input type="hidden" name="id" value={criterion.id} />
                            <Label className="flex-col items-stretch gap-1 text-muted-foreground">
                              Name
                              <Input
                                type="text"
                                name="name"
                                value={criterion.name}
                                maxLength={200}
                                className="text-foreground"
                              />
                            </Label>
                            <Label className="flex-col items-stretch gap-1 text-muted-foreground">
                              Weight
                              <Input
                                type="number"
                                name="weight"
                                min={1}
                                max={5}
                                value={criterion.weight}
                                className="text-foreground"
                              />
                            </Label>
                            <Button type="submit" variant="outline" size="sm">
                              Save
                            </Button>
                          </form>
                          <form method="POST" action="/api/criteria">
                            <input type="hidden" name="decision_id" value={decisionId} />
                            <input type="hidden" name="intent" value="delete" />
                            <input type="hidden" name="id" value={criterion.id} />
                            <Button type="submit" variant="destructive" size="sm">
                              Delete
                            </Button>
                          </form>
                        </div>
                      </CardContent>
                    </Card>
                  ))}
                  {criteria.length < 20 && (
                    <form method="POST" action="/api/criteria" class="space-y-2">
                      <input type="hidden" name="decision_id" value={decisionId} />
                      <input type="hidden" name="intent" value="create" />
                      <Label className="flex-col items-stretch gap-1 text-muted-foreground">
                        Criterion
                        <Input type="text" name="name" maxLength={200} className="text-foreground" />
                      </Label>
                      <Label className="flex-col items-stretch gap-1 text-muted-foreground">
                        Weight
                        <Input type="number" name="weight" min={1} max={5} className="text-foreground" />
                      </Label>
                      <Button type="submit">Add criterion</Button>
                    </form>
                  )}
                </section>
              </section>
            </div>
          )}
        </div>
      )}
    </CardContent>
    <CardFooter>
      <form method="POST" action="/api/auth/signout">
        <Button type="submit" variant="outline">
          Sign out
        </Button>
      </form>
    </CardFooter>
  </Card>
</div>
